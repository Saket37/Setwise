<?xml version="1.0" encoding="utf-8"?>
<!--
    Animated splash icon (Android 12+): the three bars of the Setwise mark rise from the
    baseline one after another, with a slight overshoot, like sets getting heavier.
    Same geometry as ic_launcher_foreground (48-unit grid scaled into a 108dp canvas).
    Each bar scales from its own bottom edge (pivotY = 40, the baseline).
    Whole rise takes ~720ms (starts at 100ms); MainActivity keeps the splash up until it finishes (SPLASH_ANIMATION_MS).
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:scaleX="1.375"
                android:scaleY="1.375"
                android:translateX="21"
                android:translateY="21">
                <group
                    android:name="bar1"
                    android:pivotX="12"
                    android:pivotY="40"
                    android:scaleY="0">
                    <path
                        android:fillColor="@color/setwise_volt"
                        android:pathData="M8,30 A4,4 0 0 1 16,30 V36 A4,4 0 0 1 8,36 Z" />
                </group>
                <group
                    android:name="bar2"
                    android:pivotX="24"
                    android:pivotY="40"
                    android:scaleY="0">
                    <path
                        android:fillColor="@color/setwise_volt"
                        android:pathData="M20,21 A4,4 0 0 1 28,21 V36 A4,4 0 0 1 20,36 Z" />
                </group>
                <group
                    android:name="bar3"
                    android:pivotX="36"
                    android:pivotY="40"
                    android:scaleY="0">
                    <path
                        android:fillColor="@color/setwise_volt"
                        android:pathData="M32,12 A4,4 0 0 1 40,12 V36 A4,4 0 0 1 32,36 Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="bar1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="320"
                android:interpolator="@android:anim/overshoot_interpolator"
                android:propertyName="scaleY"
                android:startOffset="100"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="bar2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="320"
                android:interpolator="@android:anim/overshoot_interpolator"
                android:propertyName="scaleY"
                android:startOffset="220"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="bar3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="380"
                android:interpolator="@android:anim/overshoot_interpolator"
                android:propertyName="scaleY"
                android:startOffset="340"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
